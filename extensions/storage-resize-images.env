IMG_BUCKET=${STORAGE_BUCKET}
IMG_SIZES=640x640,1280x1280
DELETE_ORIGINAL_FILE=false
MAKE_PUBLIC=false
RESIZED_IMAGES_PATH=thumbs
INCLUDE_PATH_LIST=/images
EXCLUDE_PATH_LIST=/images/*/thumbs
CACHE_CONTROL_HEADER=public, max-age=31536000
IMAGE_TYPE=webp
IS_ANIMATED=false
FUNCTION_MEMORY=1024
REGENERATE_TOKEN=true
CONTENT_FILTER_LEVEL=OFF
LOCATION=us-central1
